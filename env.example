# Copy to .env and fill in. Never commit .env.

POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cloudsentinel

# Ingestion mode: replay (sample files, no cloud account needed) | live
INGEST_MODE=replay

# LLM provider for the RAG assistant: anthropic | openai | ollama
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_MODEL=

# AWS (read-only credentials, live mode only)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CLOUDTRAIL_S3_BUCKET=

# Azure (read-only service principal, live mode only)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_EVENTHUB_CONNECTION_STRING=
AZURE_EVENTHUB_NAME=
